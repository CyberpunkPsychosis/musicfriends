# 复制本文件为 .env 并填入你拿到的 key。.env 已被 .gitignore 忽略，不会进仓库。
# 一家都不填也行：python generate.py --list 会显示哪些就绪、哪些待填。

# --- ACE-Step 1.5（首选：开源可商用，cover/repaint/vocal2bgm 全能）---
# 在有显卡的机器上跑官方 REST server（uv run acestep-api，默认 8001 端口），
# 把基址填这里。部署：https://github.com/ace-step/ACE-Step-1.5
ACESTEP_API_BASE=

# --- Replicate（⚠️ MusicGen 输出不可商用，已降级为实验项）---
# 获取：https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- Stable Audio / Stability AI（官方，EDM 器乐，有试用额度）---
# 获取：https://platform.stability.ai/account/keys
STABILITY_API_KEY=

# --- ElevenLabs Music（录音室级，需账号开通 Music API）---
# 获取：https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# --- Suno（⚠️ 无官方 API，第三方包装服务，有合规风险，仅作参考音频）---
# 同时需要服务商基址与 key（不同服务商不同）
SUNO_API_BASE=
SUNO_API_KEY=
